# Copy to .env and fill in. .env is gitignored; never commit a real key.
# The key is read only by the local server and is never sent to the browser.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# grok-4.3 is the cheapest model with tool calling ($1.25 / $2.50 per 1M tokens in/out).
DEFAULT_MODEL=grok-4.3
# Total tokens (input + output, all turns) one task may use before it is stopped.
MAX_TOKENS_PER_TASK=20000
# No new task starts once today's spend reaches this (UTC day).
DAILY_BUDGET_USD=1
# true = fake streamed replies, no API call, no cost. Set to false (with a key) for real Grok.
MOCK_MODE=true

# Optional
# TASK_CONCURRENCY=2
# MAX_TURNS=6
# XAI_TIMEOUT_MS=120000
# Require this value in an x-office-token header on /api/tasks (use if you expose the server on a network).
# OFFICE_TOKEN=

# Results board: how many results to keep (pinned ones are never deleted). Also editable in the board.
RESULTS_KEEP=500

# Real image generation for image tasks (xAI POST /v1/images/generations, docs.x.ai/docs/guides/image-generations).
# Paid per image (about $0.04 for grok-imagine-image-2.0) and charged to DAILY_BUDGET_USD. Off by default:
# without it, image tasks save the image prompt and the Bot's SVG drawing instead.
IMAGE_API=false
# IMAGE_MODEL=grok-imagine-image-2.0
# IMAGE_PRICE_USD=0.04

# Grok Bot Live Control (off by default). Reads bots, groups and transcripts through the PATCHED
# grok-bot-cli (never the npm package). Runs on this machine only; nothing is stored in data/.
ENABLE_GROKBOT_LIVE_CONTROL=false
# Absolute path to the patched CLI entry (must exist and be executable). Placeholder: replace it.
GROKBOT_CLI_PATH=/absolute/path/to/grok-bot-cli/dist/bin/gbot.mjs
# The CLI repo must be at this commit or Live Control stays unavailable.
# GROKBOT_CLI_COMMIT=9616503
# Your own (owner) agent id; it must appear in `gbot bots list`. Its messages are labelled as yours
# and never shown as a Bot. Placeholder: replace it.
GROKBOT_OWNER_AGENT_ID=00000000-0000-0000-0000-000000000000
# Sending to Grok Bot Desktop. Keep false: the gateway rejects this CLI's send route for server-run bots (409).
GROKBOT_LIVE_SEND_ENABLED=false
# Optional: map real agents to office characters when names differ, "<agentId>:<characterId>,…"
# GROKBOT_AGENT_MAP=
# Optional tuning
# GROKBOT_POLL_ACTIVE_MS=10000
# GROKBOT_POLL_IDLE_MS=15000
# GROKBOT_DISCOVERY_MS=300000
# GROKBOT_CLI_TIMEOUT_MS=15000
# GROKBOT_MAX_FAILURES=3
